{"data": {"id": 124171, "accession_number": "1945.172", "share_license_status": "CC0", "tombstone": "Kammavacha: Buddhist Ordination Text, 1800s. Myanmar (Burma). Cover: lacquer, gilding, and glass appliqué on wood; leaves: lacquer and gilding on cloth; text stack: 13 x 57.2 x 4.8 cm (5 1/8 x 22 1/2 x 1 7/8 in.); cover: 13 x 57.2 x 0.9 cm (5 1/8 x 22 1/2 x 3/8 in.); each leaf: 12.8 x 56.1 cm (5 1/16 x 22 1/16 in.). The Cleveland Museum of Art, Edward L. Whittemore Fund, 1945.172", "current_location": null, "title": "Kammavacha: Buddhist Ordination Text", "creation_date": "1800s", "creation_date_earliest": 1800, "creation_date_latest": 1899, "artists_tags": [], "culture": ["Myanmar (Burma)"], "technique": "Cover: lacquer, gilding, and glass appliqué on wood; leaves: lacquer and gilding on cloth", "support_materials": [], "department": "Indian and Southeast Asian Art", "collection": "Burmese Art", "type": "Manuscript", "measurements": "Text stack: 13 x 57.2 x 4.8 cm (5 1/8 x 22 1/2 x 1 7/8 in.); Cover: 13 x 57.2 x 0.9 cm (5 1/8 x 22 1/2 x 3/8 in.); Each leaf: 12.8 x 56.1 cm (5 1/16 x 22 1/16 in.)", "dimensions": {"cover": {"height": 0.13, "height_inch": 5, "height_inch_fraction": 0.125, "width": 0.572, "width_inch": 22, "width_inch_fraction": 0.5, "depth": 0.009, "depth_inch": 0, "depth_inch_fraction": 0.375}, "text stack": {"height": 0.13, "height_inch": 5, "height_inch_fraction": 0.125, "width": 0.572, "width_inch": 22, "width_inch_fraction": 0.5, "depth": 0.048, "depth_inch": 1, "depth_inch_fraction": 0.875}, "each leaf": {"height": 0.128, "height_inch": 5, "height_inch_fraction": 0.0625, "width": 0.561, "width_inch": 22, "width_inch_fraction": 0.0625}, "No Extent Specified": {"height": 0.128, "height_inch": 5, "height_inch_fraction": 0.0625, "width": 0.128, "width_inch": 5, "width_inch_fraction": 0.0625, "depth": 0.026, "depth_inch": 1, "depth_inch_fraction": 0.0}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [], "exhibitions": {"current": [{"id": 449919, "title": "Text and Image in Southern Asia", "description": "<i>Text and Image in Southern Asia</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (August 26, 2022-March 5, 2023).", "opening_date": "2022-08-26T04:00:00"}], "legacy": []}, "provenance": [{"description": "Grace M. Beaven [1889–1982], Cleveland Heights, OH, sold to the Cleveland Museum of Art", "citations": [], "footnotes": null, "date": "?–1945", "sortorder": 1}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": null, "date": "1945–", "sortorder": 2}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "The Pali text of this manuscript is written in Burmese square script, which is also known as \"tamarind seed script.\"", "early_education_description": null, "artlens_description": null, "description": "In premodern Burma, lay people commissioned lavishly ornamented manuscripts for ceremonial occasions, when officiants would read aloud from the text. Written in black lacquer, the text is in the language of Pali written in a Burmese script. It contains ordination rites and procedures for monastic ceremonies.<br> <br>The second to last page is covered with intricately drawn, winged celestial beings (<em>nats</em>) in gestures of praise. They fly amid intertwining vegetation—denoting bounty—that grows from serpentine forms that refer to rain clouds. Lionlike forms inhabit the space with them. The top and bottom covers are equally ornamented with jeweled floral patterning.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q79901828"], "internet_archive": ["https://archive.org/details/clevelandart-1945.172-kammavacha-buddhist"]}, "citations": [], "url": "https://clevelandart.org/art/1945.172", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/1945.172/1945.172_web.jpg", "width": "900", "height": "371", "filesize": "168681", "file