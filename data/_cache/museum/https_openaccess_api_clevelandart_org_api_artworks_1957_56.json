{"data": {"id": 135001, "accession_number": "1957.56", "share_license_status": "CC0", "tombstone": "Lady Holding a Vase, 1100s–1200s. China, Northern Song dynasty (960-1127) - Jin dynasty (1115-1234). Stoneware with slip decoration, Cizhou ware; overall: 19.7 x 9.5 cm (7 3/4 x 3 3/4 in.). The Cleveland Museum of Art, John L. Severance Fund, 1957.56", "current_location": null, "title": "Lady Holding a Vase", "creation_date": "1100s–1200s", "creation_date_earliest": 1100, "creation_date_latest": 1299, "artists_tags": [], "culture": ["China, Northern Song dynasty (960-1127) - Jin dynasty (1115-1234)"], "technique": "Stoneware with slip decoration, Cizhou ware", "support_materials": [], "department": "Chinese Art", "collection": "China - Song Dynasty", "type": "Ceramic", "measurements": "Overall: 19.7 x 9.5 cm (7 3/4 x 3 3/4 in.)", "dimensions": {"overall": {"height": 0.197, "height_inch": 7, "height_inch_fraction": 0.75, "width": 0.095, "width_inch": 3, "width_inch_fraction": 0.75}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [], "exhibitions": {"current": [{"id": 448467, "title": "China through the Magnifying Glass: Masterpieces in Miniature and Detail", "description": "<i>China through the Magnifying Glass: Masterpieces in Miniature and Detail</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (December 11, 2022-February 26, 2023).", "opening_date": "2022-12-10T05:00:00"}], "legacy": []}, "provenance": [{"description": "Men-chu Wang, Beijing, China. Seller's no. 58", "citations": [], "footnotes": [], "date": null, "sortorder": 1}, {"description": "Edward Chao, Hong Kong", "citations": [], "footnotes": [], "date": null, "sortorder": 2}, {"description": "(Frank Caro [1904–1980], New York, NY, sold to the Cleveland Museum of Art)", "citations": [], "footnotes": [], "date": "?–1957", "sortorder": 3}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": [], "date": "1957–", "sortorder": 4}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "This hollow stoneware figure of a woman has firing hole visible at the bottom.", "early_education_description": null, "artlens_description": null, "description": "The Cizhou ware kilns never produced for the imperial court, but made potted utensils needed in daily life. They also fired ceramic figurines, which are believed to have been used as toys. <br><br>The maid or palace lady here holds a long-necked vase of a type that watered flowers. The figurine, perhaps made as a toy for a girl, was molded in clay and covered with a white slip and transparent glaze, over which some colors in red, green, and ocher were applied. Cizhou kiln potters were one of the first in China who applied overglaze enamel-like colors on glazed, high-fired ceramics.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q80027811"], "internet_archive": ["https://archive.org/details/clevelandart-1957.56-lady-holding-a-vase"]}, "citations": [{"citation": "Lee, Sherman E. “Janus in Limbo.” <em>The Bulletin of the Cleveland Museum of Art</em> 50, no. 1 (January 1963): 3–6.", "page_number": "Reproduced: p. 3, fig. 2", "url": "https://www.jstor.org/stable/25151927"}, {"citation": "von Spee, Clarissa. \"Art In New Dimensions: Chinese Miniature and Small Objects at the Cleveland Museum of Art.\" <em>Arts of Asia </em>52, no. 4 (Winter 2022): 117–121.", "page_number": "Mentioned and reproduced: pp. 120–121, fig. 9", "url": ""}], "url": "https://clevelandart.org/art/1957.56", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/1957.56/1957.56_web.jpg", "width": "665", "height": "900", "filesize": "104805", "filename": "1957.56_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1957.56/1957.56_print.jpg", "width": "2512", "height": "3400", "filesize": "979960", "filename": "1957.56_print.jpg"}, "full": {"url": "https://openaccess-cdn