{"data": {"id": 105967, "accession_number": "1924.1046", "share_license_status": "CC0", "tombstone": "Statue of an Athlete, 1–100 CE. Italy, Roman. Marble; overall: 173.9 cm (68 7/16 in.). The Cleveland Museum of Art, Gift of the John Huntington Art and Polytechnic Trust, 1924.1046", "current_location": "103 Roman", "title": "Statue of an Athlete", "creation_date": "1–100 CE", "creation_date_earliest": 1, "creation_date_latest": 100, "artists_tags": [], "culture": ["Italy, Roman"], "technique": "marble", "support_materials": [], "department": "Greek and Roman Art", "collection": "GR - Roman", "type": "Sculpture", "measurements": "Overall: 173.9 cm (68 7/16 in.)", "dimensions": {"overall": {"height": 1.739, "height_inch": 68, "height_inch_fraction": 0.4375}, "platform": {"height": 0.229, "height_inch": 9, "height_inch_fraction": 0.0, "width": 0.686, "width_inch": 27, "width_inch_fraction": 0.0, "depth": 0.533, "depth_inch": 21, "depth_inch_fraction": 0.0}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [], "exhibitions": {"current": [{"id": 311952, "title": "Art, A Means to World Understanding", "description": "<i>Art, A Means to World Understanding</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (March 16-April 10, 1949).", "opening_date": "1949-03-16T05:00:00"}, {"id": 441481, "title": "Gallery One 2012", "description": "<i>Gallery One 2012</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (December 12, 2012-March 5, 2017).", "opening_date": "2012-12-12T05:00:00"}, {"id": 383281, "title": "Stories from Storage", "description": "<i>Stories from Storage</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (February 7-May 16, 2021).", "opening_date": "2021-02-06T05:00:00"}], "legacy": []}, "provenance": [], "find_spot": null, "related_works": [], "former_accession_numbers": ["486.1924"], "did_you_know": "For many years, this sculpture stood in the rotunda of the Cleveland Museum of Art.", "early_education_description": null, "artlens_description": null, "description": "This idealized athlete recalls Greek sculptural types invented and popularized during the 400s BC. Large-scale athletes and other sculptures like this were originally created by famous artists as sanctuary dedications. Centuries later, they were widely copied and adapted by Roman sculptors, whose clients sought their own versions of earlier masterpieces. Working in marble rather than bronze, these sculptors added certain elements for stability, such as the struts and the large tree trunk beside the right leg here. Sculptures like this one are profoundly complex, made by and for Romans but descended from Greek ancestors.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q79892140"], "internet_archive": ["https://archive.org/details/clevelandart-1924.1046-statue-of-an-athlete"]}, "citations": [{"citation": "R. Howard. \"An Athlete Attributed to Myron.\" <em>The Bulletin of the Cleveland Museum of Art</em> 11, no. 9 (1924): 170-173, 180.", "page_number": "Illus. cover.", "url": "http://www.jstor.org/stable/25136793"}, {"citation": "The Cleveland Museum of Art. <em>Handbook of the Cleveland Museum of Art</em>. Cleveland, OH: The Cleveland Museum of Art, 1925.", "page_number": "Mentioned and Reproduced: p. 61", "url": "https://archive.org/details/CMAHandbook_80839/page/n63"}, {"citation": "Amelung, W. \"Der Meister des Apollon auf dem Omphalos und seince Schule,\" <em>Jahrbuch des Deutschen Archäologischen Instituts </em>XLI, Heft 3/4 (1926),", "page_number": "pp. 247-287. Ill Taf 6-7.", "url": null}, {"citation": "The Cleveland Museum of Art. <em>Handbook of the Cleveland Museum of Art</em>. Cleveland, OH: The Cleveland Museum of Art, 1928.", "page_number": "Reproduced: p. 76", "url": "https://archive.org/details/CMAHandbook1928/page/n80"}, {"citation": "Blümel, Carl. <em>Der diskosträger Polyklets</em>. Berlin: W. de Gruyter &amp; Co, 1930.", "page_number": "Ill, p. 10, Ab