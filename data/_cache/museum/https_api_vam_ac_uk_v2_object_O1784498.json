alDescription": "Koto used by David Bowie for 'Moss Garden' from <i>Heroes</i>, ca.1977. A small, rectangular 13-stringed instrument with original cardboard box and instruction manual. The body of the koto is made of brown plastic with wood-grain decoration across the top convex surface. There is woven orange fabric applied to one end and red fabric at the other. The strings are of white synthetic material, and are held up by 12 cream coloured plastic moveable bridges. There are decorative paper stickers applied to each end. The lid of the box is printed in a red and silver pattern, and the paper instruction manual is black and white with a silhouette of a Japanese temple printed on the cover.", "artistMakerPerson": [], "artistMakerOrganisations": [], "artistMakerPeople": [], "materials": [{"text": "plastic", "id": "AAT14570"}, {"text": "metal", "id": "AAT10900"}, {"text": "fabric", "id": "THES345037"}, {"text": "synthetic fabric", "id": "x33026"}, {"text": "paper", "id": "x30308"}, {"text": "ink", "id": "AAT15012"}, {"text": "glue", "id": "AAT14815"}, {"text": "cardboard", "id": "AAT14224"}], "techniques": [{"text": "moulding", "id": "x46876"}, {"text": "glueing", "id": "AAT53012"}, {"text": "printing", "id": "AAT53319"}, {"text": "stringing", "id": "x37524"}, {"text": "stapling", "id": "AAT53021"}], "materialsAndTechniques": "Moulded plastic with metal, synthetic strings, glued fabric and printed adhesive paper\r\nPrinting ink and staples on cardboard\r\nPrinting ink on paper", "categories": [{"text": "David Bowie Archive", "id": "THES394093"}, {"text": "Entertainment and leisure", "id": "THES48959"}], "styles": [], "collectionCode": {"text": "T&P", "id": "THES48602"}, "images": ["2024NX9372", "2024NX9373", "2024NX9371", "2024NX9370", "2024NX0792", "2024NX0791", "2024NX0790", "2024NX0788", "2024NX0787", "2024NX0794", "2024NX0793", "2024NX0789", "2024NX0786"], "imageResolution": "low", "galleryLocations": [{"current": {"text": "SHLN", "id": "THES49063"}, "free": ""