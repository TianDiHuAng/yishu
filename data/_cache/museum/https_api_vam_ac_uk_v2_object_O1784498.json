ll}, "part": "Box lid", "note": ""}, {"dimension": "Height", "value": "5.8", "unit": "cm", "qualifier": "", "date": {"text": "", "earliest": null, "latest": null}, "part": "Box base", "note": ""}, {"dimension": "Length", "value": "31", "unit": "cm", "qualifier": "", "date": {"text": "", "earliest": null, "latest": null}, "part": "Box base", "note": ""}, {"dimension": "Width", "value": "7.7", "unit": "cm", "qualifier": "", "date": {"text": "", "earliest": null, "latest": null}, "part": "Box base", "note": ""}, {"dimension": "Height", "value": "9.6", "unit": "cm", "qualifier": "", "date": {"text": "", "earliest": null, "latest": null}, "part": "Instruction manual", "note": ""}, {"dimension": "Width", "value": "13.1", "unit": "cm", "qualifier": "", "date": {"text": "", "earliest": null, "latest": null}, "part": "Instruction manual", "note": ""}], "dimensionsNote": "", "marksAndInscriptions": [{"content": "", "inscriber": {"name": {"text": "", "id": ""}, "association": {"text": "", "id": ""}}, "date": {"text": "", "earliest": null, "latest": null}, "description": "", "interpretation": "", "language": "", "medium": "", "method": "", "position": "", "script": "", "translation": "", "transliteration": "", "type": "", "note": "Japanese text printed on front of manual. Japanese text and numbers printed on back of manual."}], "objectHistory": "This traditional Japanese instrument was used by Bowie to record the song ‘Moss Garden’ from his 1977 album <i>“Heroes”</i>. This song was one of four tracks on <i>“Heroes”</i> co-written with Brian Eno, and the track highlights Bowie’s long-term fascination with Japan and Japanese culture, being a conceptual piece based on a location in Kyoto, Japan. The koto is a plucked zither instrument, and the national instrument of Japan, being played on the track over a backing of soft synthesizer sounds. The decision to use the koto was perhaps inspired by the German band Neu!, whose second album (released in 1973) featured the instrument.", "historicalContext": "", "briefDescription": "Koto used by David Bowie for 'Moss Garden' from <i>Heroes</i>, ca.1977", "bibliographicReferences": [{"reference": {"text": "", "id": ""}, "details": "", "free": "Nicholas Pegg, <i>The Complete David Bowie</i> (Great Britain, 2016)"}], "production": "", "productionType": {"text": "", "id": ""}, "contentDescription": "", "contentPlaces": [], "associatedPlaces": [], "contentPerson": [], "associatedPerson": [], "contentOrganisations": [], "associatedOrganisations": [], "contentPeople": [], "associatedPeople": [], "contentEvents": [], "associatedEvents": [{"text": "Album: \"Heroes\" (1977)", "id": "AUTH401600"}], "contentOthers": [], "contentConcepts": [], "contentLiteraryRefs": [], "galleryLabels": [], "partNumbers": ["LOAN:AMERICASFOUNDATION.2131:1-2024", "LOAN:AMERICASFOUNDATION.2131:2-2024", "LOAN:AMERICASFOUNDATION.2131:3-2024", "LOAN:AMERICASFOUNDATION.2131:4-2024"], "accessionNumberNum": "2131", "accessionNumberPrefix": "LOAN:AMERICASFOUNDATION", "accessionYear": 2024, "otherNumbers": [{"type": {"text": "David Bowie Archive Number", "id": "THES394108"}, "number": "1977.3007.0057"}], "copyNumber": "", "aspects": ["WHOLE"], "assets": [], "recordModificationDate": "2026-10-26", "recordCreationDate": "2024-07-23", "availableToBook": false}}