{"meta": {"version": "2.1", "_links": {"self": {"href": "https://api.vam.ac.uk/v2/object/O1768"}, "collection_page": {"href": "https://collections.vam.ac.uk/item/O1768/"}}, "images": {"_primary_thumbnail": "https://framemark.vam.ac.uk/collections/2006AP4221/full/!100,100/0/default.jpg", "_iiif_image": "https://framemark.vam.ac.uk/collections/2006AP4221/", "_alt_iiif_image": [], "imageResolution": "high", "_images_meta": [{"assetRef": "2006AP4221", "copyright": "© Victoria and Albert Museum, London", "sensitiveImage": false}, {"assetRef": "2017KE1856", "copyright": "©Victoria and Albert Museum, London", "sensitiveImage": false}]}, "see_also": {"_iiif_pres": "https://iiif.vam.ac.uk/collections/O1768/manifest.json", "_alt_iiif_pres": []}}, "record": {"systemNumber": "O1768", "accessionNumber": "6820-1860", "objectType": "Mosque lamp", "titles": [], "summaryDescription": "This footed lamp is made of greyish colourless glass, decorated with red, white and blue enamels. It has a flared base and a slightly less flaring neck. The inscriptions and blazons on it can be related to Shibl al-Daula Kafur al-Rumi, who was the treasurer of the Mamluk Sultan of Egypt, al-Salih Isma’il (1342-1345). It was probably ordered to form part of the decorative lighting for a building commissioned by Kafur al-Rumi on behalf of this ruler.", "physicalDescription": "Footed lamp of greyish colorless glass decorated with red, white, blue enamels. Flared base and less flared neck.  Inscriptions and blazon of Shibl al-Daula Kafur al-Rumi, treasurer to the Mamluk Sultan al-Salih Isma`il (1342-45)", "artistMakerPerson": [{"name": {"text": "Unknown", "id": "A1848"}, "association": {"text": "", "id": ""}, "note": ""}], "artistMakerOrganisations": [], "artistMakerPeople": [], "materials": [{"text": "glass", "id": "AAT10797"}, {"text": "enamel", "id": "AAT14910"}, {"text": "gilt", "id": "x30367"}], "techniques": [{"text": "firing", "id": "AAT53887"}, {"text": "painting", "id": "x30598"}, {"text": "gilding", "id": "AAT53789"}], "materialsAndTechniques": "Glass, gilded and enamelled", "categories": [{"text": "Islam", "id": "THES48932"}, {"text": "Glass", "id": "THES48946"}, {"text": "Lighting", "id": "THES48925"}, {"text": "Africa", "id": "THES49019"}], "styles": [{"text": "Mamluk", "id": "AAT21601"}], "collectionCode": {"text": "MES", "id": "THES48607"}, "images": ["2006AP4221", "2017KE1856"], "imageResolution": "high", "galleryLocations": [{"current": {"text": "42 (VA)", "id": "THES49806"}, "free": "", "case": "WE7", "shelf": "1", "box": ""}], "partTypes": [[{"text": "Lamp", "id": ""}]], "contentWarnings": [{"apprise": "", "note": ""}], "placesOfOrigin": [{"place": {"text": "Egypt", "id": "x29512"}, "association": {"text": "made", "id": "x28654"}, "note": "possibly"}, {"place": {"text": "Syria", "id": "x29200"}, "association": {"text": "made", "id": "x28654"}, "note": "possibly"}], "productionDates": [{"date": {"text": "1342-1345", "earliest": "1342-01-01", "latest": "1345-12-31"}, "association": {"text": "made", "id": "x28654"}, "note": ""}], "associatedObjects": [], "creditLine": "", "dimensions": [{"dimension": "Height", "value": "26", "unit": "cm", "qualifier": "", "date": {"text": "", "earliest": null, "latest": null}, "part": "", "note": ""}, {"dimension": "Width", "value": "17", "unit": "cm", "qualifier": "", "date": {"text": "", "earliest": null, "latest": null}, "part": "maximum", "note": ""}], "dimensionsNote": "", "marksAndInscriptions": [{"content": "Inscriptions and blazon of Shibl al-Daula Kafur al-Rumi, treasurer to the Mamluk Sultan al-Salih Isma'il (1342-45)", "inscriber": {"name": {"text": "", "id": ""}, "association": {"text": "", "id": ""}}, "date": {"text": "", "earliest": null, "latest": null}, "description": "", "interpretation": "", "language": "Arabic", "medium": "", "method": "", "position": "on body", "script": "naskhi", "translation": "", "transliteration": "", "type": "Decoration", "note": "Decoration; Arabic; naskhi; on body"}], "objectHistory": "Ordered for a building commissioned by Kafur al-Rumi, Treasurer to the Mamluk Sultan of Egypt al-Salih Ismail (1342-45).", "historicalContext": "", "briefDescription": "Lamp with inscriptions naming the Mamluk official Kafur al-Rumi, Egypt, 1342-5.", "bibliographicReferences": [{"reference": {"text": "", "id": ""}, "details": "", "free": "Lamm (1930; 200:2), Wiet (1929;p.164,no.51), Mayer (Saracenic Heraldry; p.135)"}, {"reference": {"text": "Tim Stanley (ed.), with Mariam Rosser-Owen and Stephen Vernoit, <i>Palace and Mosque: Islamic Art from the Middle East</i>, London, V&A Publications, 2004", "id": "AUTH351313"}, "details": "pp.24, 45, 49, 52", "free": ""}], "production": "date: 'probably'", "productionType": {"text": "", "id": ""}, "contentDescription": "", "contentPlaces": [], "associatedPlaces": [], "contentPerson": [], "associatedPerson": [], "contentOrganisations": [], "associatedOrganisations": [], "contentPeople": [], "associatedPeople": [], "contentEvents": [], "associatedEvents": [], "contentOthers": [{"text": "geometric patterns", "id": "AAT165213"}], "contentConcepts": [], "contentLiteraryRefs": [], "galleryLabels": [{"text": "Jameel Gallery \r\n\r\nGlass Lamps\r\nEgypt or Syria\r\nAbout 1250 and 1342–5\r\n\r\nThe lamp on the left is decorated with three mounted falconers. The presence of human figures indicates that it was made for a domestic, non-religious setting. The lamp on the right has no figures. It was probably commissioned for a religious institution by a Mamluk official called Kafur al-Rumi, who is named in the inscriptions. \r\n\r\nGlass, enamelled and gilded\r\n\r\nMuseum nos. 330-1900; 6820-1860", "date": {"text": "Jameel Gallery", "earliest": "2006-07-20", "latest": null}}], "partNumbers": ["6820-1860"], "accessionNumberNum": "6820", "accessionNumberPrefix": "", "accessionYear": 1860, "otherNumbers": [], "copyNumber": "", "aspects": ["WHOLE"], "assets": ["2019LP8955", "2019LP2281", "2019LT7834", "2019LV3422"], "recordModificationDate": "2025-04-19", "recordCreationDate": "1997-12-13", "availableToBook": false}}