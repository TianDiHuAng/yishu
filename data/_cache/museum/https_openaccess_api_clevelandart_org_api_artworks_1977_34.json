{"data": {"id": 149101, "accession_number": "1977.34", "share_license_status": "CC0", "tombstone": "Corner Railing Pillar with Drinking Scenes, Yakshis, and Musicians, 100s CE. India, Mathura, Kushan period. Red sandstone; overall: 80 x 22.9 x 24 cm (31 1/2 x 9 x 9 7/16 in.). The Cleveland Museum of Art, John L. Severance Fund, 1977.34", "current_location": "242A Ancient India", "title": "Corner Railing Pillar with Drinking Scenes, Yakshis, and Musicians", "creation_date": "100s CE", "creation_date_earliest": 100, "creation_date_latest": 199, "artists_tags": [], "culture": ["India, Mathura, Kushan period"], "technique": "red sandstone", "support_materials": [], "department": "Indian and Southeast Asian Art", "collection": "Indian Art - Kushan, Mathura", "type": "Sculpture", "measurements": "Overall: 80 x 22.9 x 24 cm (31 1/2 x 9 x 9 7/16 in.)", "dimensions": {"overall": {"height": 0.8, "height_inch": 31, "height_inch_fraction": 0.5, "width": 0.229, "width_inch": 9, "width_inch_fraction": 0.0, "depth": 0.24, "depth_inch": 9, "depth_inch_fraction": 0.4375}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [], "exhibitions": {"current": [{"id": 302666, "title": "Year in Review: 1977", "description": "<i>Year in Review: 1977</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (December 28, 1977-January 22, 1978).", "opening_date": "1977-12-28T05:00:00"}, {"id": 309887, "title": "The Twain Shall Meet", "description": "<i>The Twain Shall Meet</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (October 30, 1985-January 5, 1986).", "opening_date": "1985-10-30T05:00:00"}, {"id": 309889, "title": "Kushan Sculpture: Images from Early India", "description": "<i>Kushan Sculpture: Images from Early India</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (November 13, 1985-January 5, 1986); The Asia Society Museum, New York, NY (February 13-April 6, 1986); Seattle Art Museum, Seattle, WA (May 13-July 13, 1986).", "opening_date": "1985-11-13T05:00:00"}, {"id": 412350, "title": "Buddha in India", "description": "<i>Buddha in India</i>. Kunsthistorisches Museum Wien (organizer) (April 2-July 16, 1995).", "opening_date": "1995-04-02T05:00:00"}, {"id": 196054, "title": "Streams and Mountains Without End: Asian Art and the Legacy of Sherman E. Lee at the Cleveland Museum of Art", "description": "<i>Streams and Mountains Without End: Asian Art and the Legacy of Sherman E. Lee at the Cleveland Museum of Art</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (June 27-August 23, 2009).", "opening_date": "2009-06-27T04:00:00"}, {"id": 441481, "title": "Gallery One 2012", "description": "<i>Gallery One 2012</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (December 12, 2012-March 5, 2017).", "opening_date": "2012-12-12T05:00:00"}], "legacy": []}, "provenance": [{"description": "(Wiener Gallery, New York, NY, sold to the Cleveland Museum of Art)", "citations": [], "footnotes": null, "date": "?–1977", "sortorder": 1}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": [], "date": "1977–", "sortorder": 2}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "The celestial musicians, who play a lyre, castanets, and a triangular harp, evoke bacchanalian connotations.", "early_education_description": null, "artlens_description": null, "description": "This pillar reflects the influence of Greco-Roman culture on Indian art and the influence of Gandharan styles and bacchanalian themes on the art of Mathura. The pillar depicts female figures who, seemingly intoxicated, play instruments and dance. Two additional scenes are carved on the base. First, a hunchbacked woman pours wine for an obese male fertility figure (<em>yaksha</em>). The second scene probably illustrates the story of the horse-headed yakshi who ate her victims.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q79929951"], "internet_archive": ["https://archive.org/details/clevelandart-1977.34-corner-railing-pilla"]}, "citations": [{"citation": "The Cleveland Museum of Art. <em>Handbook of the Cleveland Museum of Art/1978</em>. Cleveland, OH: The Cleveland Museum of Art, 1978.", "page_number": "Reproduced: p. 289", "url": "https://archive.org/details/CMAHandbook1978/page/n309"}, {"citation": "Lee, Sherman E. “The Year in Review for 1977.” <em>The Bulletin of the Cleveland Museum of Art</em>, vol. 65, no. 1, 1978, pp. 2–43.", "page_number": "Mentioned: no. 151, p. 43; Reproduced: no. 151, p. 30", "url": "https://www.jstor.org/stable/25159560"}, {"citation": "Buren, Geneviève de. <em>La chronique des arts: principales acquisitions des musées en 1977</em>. Lausanne: Gazette des beaux-arts, 1978.", "page_number": "Mentioned and Reproduced: cat. no. 178, p. 38", "url": ""}, {"citation": "\"Annual Report for 1977.\" <em>The Bulletin of the Cleveland Museum of Art</em> 65, no. 6 (1978): 177-215.", "page_number": "Mentioned: p. 191", "url": "http://www.jstor.org/stable/25159587"}, {"citation": "Carter, Martha L. “The Bacchants of Mathura: New Evidence of Dionysiac Yaksha Imagery from Kushan Mathura.” <em>The Bulletin of the Cleveland Museum of Art</em>, vol. 69, no. 8, 1982, pp. 247–257.", "page_number": "Mentioned and Reproduced: pp. 247–250", "url": "www.jstor.org/stable/25159785"}, {"citation": "Neils, Jenifer. “The Twain Shall Meet.” <em>The Bulletin of the Cleveland Museum of Art</em>, vol. 72, no. 6, 1985, pp. 326–359.", "page_number": "Reproduced: p. 337, fig. 17", "url": "https://www.jstor.org/stable/25159914"}, {"citation": "Czuma, Stanislaw J., and Rekha Morris. <em>Kushan Sculpture: Images from Early India</em>. Cleveland, OH: Cleveland Museum of Art in cooperation with Indiana University Press, 1985.", "page_number": "Mentioned and Reproduced: cat. no. 42, p. 111", "url": null}, {"citation": "Cunningham, Michael R., Stanislaw J. Czuma, Anne E. Wardwell, and J. Keith Wils