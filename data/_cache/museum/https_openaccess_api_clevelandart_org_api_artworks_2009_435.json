{"data": {"id": 167824, "accession_number": "2009.435", "share_license_status": "CC0", "tombstone": "Bowl with Trophy Heads, c. 100–650 CE. Peru, Nasca, Early Intermediate Period. Ceramic, slip; overall: 10.2 x 10.2 cm (4 x 4 in.). The Cleveland Museum of Art, Gift of Barry Bradley, 2009.435", "current_location": "232 Andean", "title": "Bowl with Trophy Heads", "creation_date": "c. 100–650 CE", "creation_date_earliest": 100, "creation_date_latest": 650, "artists_tags": [], "culture": ["Peru, Nasca, Early Intermediate Period"], "technique": "ceramic, slip", "support_materials": [], "department": "Art of the Americas", "collection": "AA - Andes", "type": "Ceramic", "measurements": "Overall: 10.2 x 10.2 cm (4 x 4 in.)", "dimensions": {"overall": {"height": 0.102, "height_inch": 4, "height_inch_fraction": 0.0, "width": 0.102, "width_inch": 4, "width_inch_fraction": 0.0}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [], "exhibitions": {"current": [], "legacy": []}, "provenance": [{"description": "Estate of Barry Bradley, Cleveland, Ohio", "citations": [], "footnotes": null, "date": null, "sortorder": null}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "Two important themes in Nasca art are war and fertility.", "early_education_description": null, "artlens_description": null, "description": "Nasca is one of the two major cultures and ceramic styles of its periods, and one of the finest ceramic styles ever produced in the South American Andes. Vessel walls are thin, firing temperatures higher than in earlier times, and a variety of warm, earthen-toned slips come into use. This small bowl features repetitions of human trophy heads—a major Nasca motif that refers both to war and fertility.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q60748730"], "internet_archive": ["https://archive.org/details/clevelandart-2009.435-bowl-with-trophy-hea"]}, "citations": [], "ur