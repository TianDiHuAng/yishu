{"data": {"id": 159515, "accession_number": "1996.28", "share_license_status": "CC0", "tombstone": "Statue of Minemheb, c. 1391–1353 BCE. Egypt, New Kingdom (1540–1069 BCE), Dynasty 18, reign of Amenhotep III (1390–1352 BCE). Granodiorite; overall: 45 x 16.6 x 28.3 cm (17 11/16 x 6 9/16 x 11 1/8 in.). The Cleveland Museum of Art, Leonard C. Hanna Jr. Fund, 1996.28", "current_location": "107 Egyptian", "title": "Statue of Minemheb", "creation_date": "c. 1391–1353 BCE", "creation_date_earliest": -1391, "creation_date_latest": -1353, "artists_tags": [], "culture": ["Egypt, New Kingdom (1540–1069 BCE), Dynasty 18, reign of Amenhotep III (1390–1352 BCE)"], "technique": "granodiorite", "support_materials": [], "department": "Egyptian and Ancient Near Eastern Art", "collection": "Egypt - New Kingdom", "type": "Sculpture", "measurements": "Overall: 45 x 16.6 x 28.3 cm (17 11/16 x 6 9/16 x 11 1/8 in.)", "dimensions": {"overall": {"height": 0.45, "height_inch": 17, "height_inch_fraction": 0.6875, "width": 0.166, "width_inch": 6, "width_inch_fraction": 0.5625, "depth": 0.283, "depth_inch": 11, "depth_inch_fraction": 0.125}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [], "exhibitions": {"current": [{"id": 311471, "title": "Egypt's Dazzling Sun: Amenhotep III and His World", "description": "<i>Egypt's Dazzling Sun: Amenhotep III and His World</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (July 1-September 27, 1992); Kimbell Art Museum, Fort Worth, TX (October 24, 1992-January 31, 1993); Galeries Nationales du Grand Palais, 75008 Paris, France (March 2-May 31, 1993).", "opening_date": "1992-07-01T04:00:00"}], "legacy": []}, "provenance": [{"description": "E. G. Massey, Geneva, OH", "citations": [], "footnotes": null, "date": "1957-1972", "sortorder": 1}, {"description": "Robert Haber and Associates, Inc., New York, NY, sold to the Cleveland Museum of Art", "citations": [], "footnotes": null, "date": "?-1996", "sortorder": 2}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": null, "date": "1996-", "sortorder": 3}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "The baboon in this sculpture is the god Thoth in one of his animal forms.", "early_education_description": null, "artlens_description": null, "description": "Minemheb was one of the many court officials who helped prepare for Amenhotep III's 30-year jubilee festival. Clearly, Minemheb regarded this as the high point of his career, since his title as chief of construction for the jubilee temple is the primary one provided on this statue. It is actually a statue within a statue: Minemheb kneels to present a small altar, upon which squats a statue of the god Thoth in baboon form. Carved in extremely hard stone, Minemheb's statue is nonetheless carefully detailed and superbly modeled. Special attention was given to the rendering of the baboon's face. The heavy-lidded eyes and furrowed brow give the animal an almost contemplative expression.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q60752521"], "internet_archive": ["https://archive.org/details/clevelandart-1996.28-statue-of-minemheb"]}, "citations": [{"citation": "Kozloff, Arielle P., Betsy Morrell Bryan, Lawrence Michael Berman, and Elisabeth Delange. <em>Egypt's Dazzling Sun: Amenhotep III and His World. </em>Cleveland: Cleveland Museum of Art in cooperation with Indiana University Press, 1992.", "page_number": "Cat. No. 40", "url": null}, {"citation": "Cleveland Museum of Art, “Cleveland Museum of Art Acquires Rare Egyptian Sculpture, Old Master Painting, Important Cambodian Bronze,” June 13, 1996, Cleveland Museum of Art Archives.", "page_number": null, "url": "https://archive.org/details/cmapr4046"}, {"citation": "Kozloff, Arielle. \"An Old Friend Returns,\" <em>Cleveland Museum of Art Members Magazine</em> 37, no. 1 (January 1997).", "page_number": "pp. 4-5", "url": "https://archive.org/details/CMAMM1997-01/page/n3"}, {"citation": "Berman, Lawrence M., and Kenneth J. Bohač.<em> Catalogue of Egyptian Art: The Cleveland Museum of Art.</em> Cleveland, OH: Cleveland Museum of Art, 1999", "page_number": "Reproduced: p. 233-235; Mentioned: p. 233-235", "url": null}, {"citation": "May, Sally Ruth. <em>Knockouts: a pocket guide.</em> Cleveland: Cleveland Museum of Art, 2001.", "page_number": "Reproduced: no. 7, p. 12", "url": ""}, {"citation": "Cleveland Museum of Art. <em>The CMA Companion: A Guide to the Cleveland Museum of Art</em>. Cleveland: Cleveland Museum of Art, 2014.", "page_number": "Mentioned and reproduced: P. 72-73", "url": ""}, {"citation": "Bennett, Michael. “A Walking Tour: The entire new museum wing by wing, with curators calling out a few favorite works in the collection.” <em>Cleveland Art: Cleveland Museum of Art Members Magazine</em> 54, no. 1 (January/February 2014): 8-33.", "page_number": "Reproduced: p. 11; Mentioned: p. 10", "url": "https://archive.org/details/CMAMM2014-01"}], "url": "https://clevelandart.org/art/1996.28", "images": {"annotation": "2013 Photography, Remastered 2026", "web": {"url": "https://openaccess-cdn.clevelandart.org/1996.28/1996.28_web.jpg", "width": "737", "height": "900", "filesize": "162987", "filename": "1996.28_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1996.28/1996.28_print.jpg", "width": "2786", "height": "3400", "filesize": "1539270", "filename": "1996.28_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1996.28/1996.28_full.tif", "width": "5546", "height": "6768", "filesize": "112653656", "filename": "1996.28_full.tif"}}, "alternate_images": [{"web": {"url": "https://openaccess-cdn.clevelandart.org/1996.28/1996.28_alt0_web.jpg", "width": "637", "height": "893", "filesize": "88100"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1996.28/1996.28_alt0_print.jpg", "width": "2426", "height": "3400", "filesize": "1166314"