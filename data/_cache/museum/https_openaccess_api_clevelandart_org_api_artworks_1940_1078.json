{"data": {"id": 118875, "accession_number": "1940.1078", "share_license_status": "CC0", "tombstone": "Ceremonial Adze, 1800s. Polynesia, Mangaia, Cook Islands, 19th century. Wood, stone, fiber; overall: 10.2 cm (4 in.); blade: 9.3 x 3.6 cm (3 11/16 x 1 7/16 in.). The Cleveland Museum of Art, Gift of Richard Inglis, 1940.1078", "current_location": null, "title": "Ceremonial Adze", "creation_date": "1800s", "creation_date_earliest": 1800, "creation_date_latest": 1899, "artists_tags": [], "culture": ["Polynesia, Mangaia, Cook Islands, 19th century"], "technique": "wood, stone, fiber", "support_materials": [], "department": "Oceania", "collection": "Oceanic Art", "type": "Sculpture", "measurements": "Overall: 10.2 cm (4 in.); Blade: 9.3 x 3.6 cm (3 11/16 x 1 7/16 in.)", "dimensions": {"overall": {"width": 0.102, "width_inch": 4, "width_inch_fraction": 0.0, "length": 1.244, "length_inch": 49, "length_inch_fraction": 0.0}, "blade": {"width": 0.093, "width_inch": 3, "width_inch_fraction": 0.6875, "depth": 0.036, "depth_inch": 1, "depth_inch_fraction": 0.4375, "length": 0.207, "length_inch": 8, "length_inch_fraction": 0.125}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [], "exhibitions": {"current": [{"id": 519209, "title": "The Imagination of Primitive Man", "description": "<i>The Imagination of Primitive Man</i>. The Nelson-Atkins Museum of Art, Kansas City, MO (organizer) (January 18-February 25, 1962).", "opening_date": "1962-01-18T05:00:00"}], "legacy": []}, "provenance": [], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": null, "early_education_description": null, "artlens_description": null, "description": "Before European contact, Polynesian carving tools were fashioned from bone, shell, stone, or teeth. The introduction of iron tools facilitated carving, while the demand of European sailors and missionaries for souvenirs provided a new market for craft products. Ceremonial adzes probably represented gods or spirits. The wooden handle of this example is carved with the characteristic K motif. The stone adze blade is lashed to the handle with finely plaited sennit fiber cord. According to legend, the distinctive pattern formed by the sennit lashing was taught to Mangaian craftsman by the gods.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q80013905"], "internet_archive": ["https://archive.org/details/clevelandart-1940.1078-ceremonial-adze"]}, "citations": [{"citation": "William Rockhill Nelson Gallery of Art and Mary Atkins Museum of Fine Arts, and Ralph T. Coe. <em>The Imagination of Primitive Man: A Survey of the Arts of the Non-Literate Peoples of the World</em>. Kansas City, Mo: The Museum, 1962.", "page_number": "Mentioned: p. 82, no 142; Reproduced: p. 83, no. 142", "url": null}, {"citation": "The Cleveland Museum of Art. <em>Handbook of the Cleveland Museum of Art/1966</em>. Cleveland, OH: The Cleveland Museum of Art, 1966.", "page_number": "Reproduced: p. 305", "url": "https://archive.org/details/CMAHandbook1966/page/n329"}, {"citation": "The Cleveland Museum of Art. <em>Handbook of the Cleveland Museum of Art/1969</em>. Cleveland, OH: The Cleveland Museum of Art, 1969.", "page_number": "Reproduced: p. 305", "url": "https://archive.org/details/CMAHandbook1969/page/n329"}, {"citation": "The Cleveland Museum of Art. <em>Handbook of the Cleveland Museum of Art/1978</em>. Cleveland, OH: The Cleveland Museum of Art, 1978.", "page_number": "Reproduced: p. 417", "url": "https://archive.org/details/CMAHandbook1978/page/n437"}], "url": "https://clevelandart.org/art/1940.1078", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/1940.1078/1940.1078_web.jpg", "width": "398", "height": "900", "filesize": "128240", "filename": "1940.1078_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1940.1078/1940.1078_print.jpg", "width": "1504", "height": "3400", "filesize": "54548