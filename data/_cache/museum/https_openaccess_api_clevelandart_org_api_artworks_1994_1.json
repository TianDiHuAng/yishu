{"data": {"id": 157216, "accession_number": "1994.1", "share_license_status": "CC0", "tombstone": "Inscription Plaque, Possibly from a Door, c. 1693. Iran, Safavid period (1501–1722). Forged steel, cut to shape and pierced; overall: 27 x 35 cm (10 5/8 x 13 3/4 in.). The Cleveland Museum of Art, Andrew R. and Martha Holden Jennings Fund, 1994.1", "current_location": "116 Islamic", "title": "Inscription Plaque, Possibly from a Door", "creation_date": "c. 1693", "creation_date_earliest": 1688, "creation_date_latest": 1698, "artists_tags": [], "culture": ["Iran, Safavid period (1501–1722)"], "technique": "forged steel, cut to shape and pierced", "support_materials": [], "department": "Islamic Art", "collection": "Islamic Art", "type": "Metalwork", "measurements": "Overall: 27 x 35 cm (10 5/8 x 13 3/4 in.)", "dimensions": {"overall": {"height": 0.27, "height_inch": 10, "height_inch_fraction": 0.625, "width": 0.35, "width_inch": 13, "width_inch_fraction": 0.75}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [{"inscription": "Muhaqqaq, Qur'an 33:56 'Verily, God and His Angels send blessings on the Prophet'.", "inscription_translation": null, "inscription_remark": null, "sortorder": null}], "exhibitions": {"current": [{"id": 396857, "title": "Art of the Islamic World (Islamic art rotation)", "description": "<i>Art of the Islamic World (Islamic art rotation)</i>. The Cleveland Museum of Art (organizer) (May 21, 2021-May 31, 2022).", "opening_date": "2021-05-21T04:00:00"}], "legacy": []}, "provenance": [{"description": "(Oliver Hoare Ltd., London, UK, sold to the Cleveland Museum of Art)", "citations": [], "footnotes": null, "date": "?-1994", "sortorder": 2}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": null, "date": "1994-", "sortorder": 3}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "Calligraphy was the supreme art form in the Islamic wo