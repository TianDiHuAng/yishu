{"data": {"id": 695986, "accession_number": "2025.180", "share_license_status": "CC0", "tombstone": "Celadon Cup with Molded Lotus Petal Design (청자 음각 연꽃잎무늬 잔), 1100s–1200s. Korea, Goryeo dynasty (918–1392). Celadon; height: 11 cm (4 5/16 in.); diameter of rim: 10.7 cm (4 3/16 in.); diameter of foot: 8.7 cm (3 7/16 in.). The Cleveland Museum of Art, Gift of Mr. Sang-goo Kong in celebration of the museum’s Korean art collection, 2025.180", "current_location": "003 Special Exhibition Hall", "title": "Celadon Cup with Molded Lotus Petal Design", "title_in_original_language": "청자 음각 연꽃잎무늬 잔", "creation_date": "1100s–1200s", "creation_date_earliest": 1100, "creation_date_latest": 1299, "artists_tags": [], "culture": ["Korea, Goryeo dynasty (918–1392)"], "technique": "Celadon", "support_materials": [], "department": "Korean Art", "collection": "Korean Art", "type": "Ceramic", "measurements": "height: 11 cm (4 5/16 in.); Diameter of rim: 10.7 cm (4 3/16 in.); Diameter of foot: 8.7 cm (3 7/16 in.)", "dimensions": {"height": {"height": 0.11, "height_inch": 4, "height_inch_fraction": 0.3125}, "diameter of rim": {"width": 0.107, "width_inch": 4, "width_inch_fraction": 0.1875}, "diameter of foot": {"width": 0.087, "width_inch": 3, "width_inch_fraction": 0.4375}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [], "exhibitions": {"current": [{"id": 686413, "title": "Ten Kings of Hell: The Afterlife in Medieval Korea", "description": "<i>Ten Kings of Hell: The Afterlife in Medieval Korea</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (October 11, 2026-January 3, 2027).", "opening_date": "2026-10-11T04:00:00"}], "legacy": []}, "provenance": [{"description": "Private Collection", "citations": [], "footnotes": null, "date": null, "sortorder": 1}, {"description": "My Art Auction, Seoul, South Korea", "citations": [], "footnotes": null, "date": "?–2025", "sortorder": 2}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": null, "date": "2025–", "sortorder": 3}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "The outer wall of this teacup is decorated with the image of lotus flower petal, a symbol of purity and salvation.", "early_education_description": null, "artlens_description": null, "description": "Celadon wares intended for everyday use—such as this dish—were among the most common burial objects placed in tombs during the Goryeo period (918–1392). Furnishing tombs with elaborate assemblages of objects was believed to honor the deceased and provide comfort in the afterlife. This dish, featuring the lotus petal motif, was likely a cherished possession that accompanied its owner to their final resting place.", "external_resources": {"wikidata": [], "internet_archive": []}, "citations": [{"citation": "McCormick, Sooa, Yukio Lippit, and In Hee Song. <em>Ten Kings of Hell: The Afterlife in Medieval Korea.</em> Cleveland, OH: The Cleveland Museum of Art, 2026.", "page_number": "Mentioned: p. 274; Reproduced: p. 263, plate 107", "url": ""}], "url": "https://clevelandart.org/art/2025.180", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/2025.180/2025.180_web.jpg", "width": "900", "height": "761", "filesize": "101129", "filename": "2025.180_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/2025.180/2025.180_print.jpg", "width": "3400", "height": "2873", "filesize": "1110450", "filename": "2025.180_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/2025.180/2025.180_full.tif", "width": "11074", "height": "9359", "filesize": "310951140", "filename": "2025.180_full.tif"}}, "alternate_images": [{"web": {"url": "https://openaccess-cdn.clevelandart.org/2025.180/2025.180_alt0_web.jpg", "width": "900", "height": "762", "filesize": "106443"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/2025.180/2025.180_alt0_print.jpg", "width": "34