{"data": {"id": 156517, "accession_number": "1992.230", "share_license_status": "CC0", "tombstone": "Apollo and Daphne, c. 1700. Massimiliano Soldani (Italian, 1656–1740). Terracotta; overall: 55.5 x 34.2 x 21.9 cm (21 7/8 x 13 7/16 x 8 5/8 in.). The Cleveland Museum of Art, The Severance and Greta Millikin Purchase Fund, 1992.230", "current_location": "217 Italian Baroque", "title": "Apollo and Daphne", "creation_date": "c. 1700", "creation_date_earliest": 1695, "creation_date_latest": 1705, "artists_tags": ["male"], "culture": ["Italy, Florence"], "technique": "terracotta", "support_materials": [], "department": "European Painting and Sculpture", "collection": "Sculpture", "type": "Sculpture", "measurements": "Overall: 55.5 x 34.2 x 21.9 cm (21 7/8 x 13 7/16 x 8 5/8 in.)", "dimensions": {"overall": {"height": 0.555, "height_inch": 21, "height_inch_fraction": 0.875, "width": 0.342, "width_inch": 13, "width_inch_fraction": 0.4375, "depth": 0.219, "depth_inch": 8, "depth_inch_fraction": 0.625}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [], "exhibitions": {"current": [{"id": 311552, "title": "Selected Acquisitions", "description": "<i>Selected Acquisitions</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (February 9-April 11, 1993).", "opening_date": "1993-02-09T05:00:00"}, {"id": 292699, "title": "Artlens Exhibition 2017", "description": "<i>Artlens Exhibition 2017</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (June 24, 2017-May 29, 2019).", "opening_date": "2017-06-24T04:00:00"}], "legacy": []}, "provenance": [{"description": "Private collection of Mrs. Elizabeth Parke Firestone (Newport, Rhode Island).", "citations": [], "footnotes": null, "date": "1897–1959", "sortorder": null}, {"description": "Upon her death, held in trust by the estate of Mrs. Elizabeth Parke Firestone.", "citations": [], "footnotes": null, "date": "1959–1990", "sortorder": null}, {"description": "Estate of Elizabeth Parke Firestone [sold, Christie's, New York, lot no. 840, to Daniel Katz., Ltd.).", "citations": [], "footnotes": null, "date": "1990–1991", "sortorder": null}, {"description": "Daniel Katz., Ltd., sold to the Cleveland Museum of Art.", "citations": [], "footnotes": null, "date": "1991–1992", "sortorder": null}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "Soldani shows Daphne in the process of turning into a tree to escape the persistent Apollo.", "early_education_description": null, "artlens_description": null, "description": "Apollo, the Greek and Roman god of the sun and the arts, fell in love with the nymph Daphne. Chased to a riverbank, Daphne prayed to her father, the river god, Peneus, for help. At the moment Apollo reached out to touch her, she transformed into a laurel tree, branches and roots sprouting from her body. This work reveals key preoccupations of artists working in Italy in the 1600s: novel, active compositions; fleeting moments; and transformation from one physical form into another. Soldani based this work on a large-scale marble sculpture from 1622–25 by the Roman artist Gian Lorenzo Bernini.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q60756590"], "internet_archive": ["https://archive.org/details/clevelandart-1992.230-apollo-and-daphne"]}, "citations": [{"citation": "Morazzoni, Giuseppe, and Saul Levy. <em>Le Porcellane Italiane</em>. Milano: Görlich, 1960.", "page_number": "Reproduced: Vol. II, pl. 233", "url": null}, {"citation": "Lankheit, Klaus. <em>Florentinische Barockplastik; die Kunst am Hofe der letzten Medici, 1670–1743.</em> [München]: F. Bruckmann, 1962.", "page_number": "Mentioned: pp. 136–137", "url": null}, {"citation": "Lankheit, Klaus. <em>Die Modellsammlung der Porzellanmanufaktur Doccia: ein Dokument italienischer Barockplastik</em>. München, Germany: Bruckmann, 1982.", "page_number": "Reproduced: p. 23, no. 31", "url": null}, {"citation": "Laverack, Peter. <em>Daniel Katz Ltd., 1968–1993: A Catalogue Celebrating Twenty-Five Years of Dealing in European Sculpture and Works of Art, in Two Sections</em>. London, United Kingdom: Daniel Katz Ltd, 1992.", "page_number": "Reproduced: p. 33", "url": null}, {"citation": "Turner, Evan H. \"The Year in Review for 1992.\" <em>The Bulletin of The Cleveland Museum of Art LXXX</em>, no. 2 (February, 1993): 39–79.", "page_number": "Reproduced: p. 56,  no. 25; Mentioned: p. 66", "url": "http://www.jstor.org/stable/25161388"}, {"citation": "Avery, Charles. \"Soldani's Bronze Reliefs of 'Summer' and 'Autumn': New Documentation and Observations on Their Date &amp; Patronage.\" <em>The Register of the Spencer Museum of Art </em>VII, no. 1 &amp; 2 (1995):1–17.", "page_number": "Reproduced: p. 8, fig. 10", "url": null}], "url": "https://clevelandart.org/art/1992.230", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/1992.230/1992.230_web.jpg", "width": "735", "height": "900", "filesize": "135575", "filename": "1992.230_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1992.230/1992.230_print.jpg", "width": "2778", "height": "3400", "filesize": "1210743", "filename": "1992.230_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1992.230/1992.230_full.tif", "width": "10652", "height": "13036", "filesize": "103354356", "filename": "1992.230_full.tif"}}, "alternate_images": [{"web": {"url": "https://openaccess-cdn.clevelandart.org/1992.230/1992.230_alt0_web.jpg", "width": "732", "height": "900", "filesize": "115303"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1992.230/1992.230_alt0_print.jpg", "width": "2765", "height": "3400", "filesize": "1016882"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1992.230/1992.230_alt0_full.tif", "width": "10652", "height": "13098", "filesize": "93763032"}, "date_created": "2026-09-29T16:18:47", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.cle