{"data": {"id": 692270, "accession_number": "2025.152", "share_license_status": "CC0", "tombstone": "Necklace (ashän ketab) with amulet pendants (tälsäm), late 1800s or early 1900s. Africa, East Africa, Ethiopia, unknown silversmith. Silver alloy. The Cleveland Museum of Art, Gift of Raymond A. Silverman, 2025.152", "current_location": "108C African Jewelry and Metalwork", "title": "Necklace (ashän ketab) with amulet pendants (tälsäm)", "creation_date": "late 1800s or early 1900s", "creation_date_earliest": 1850, "creation_date_latest": 1925, "artists_tags": [], "culture": ["Africa, East Africa, Ethiopia, unknown silversmith"], "technique": "silver alloy", "support_materials": [], "department": "African Art", "collection": "African Art", "type": "Jewelry", "dimensions": {}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [], "exhibitions": {"current": [{"id": 692255, "title": "Silver, Gold, and Gems: A Spotlight on Jewelry Across Africa", "description": "<i>Silver, Gold, and Gems: A Spotlight on Jewelry Across Africa</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (December 7, 2025-December 6, 2026).", "opening_date": "2025-12-07T05:00:00"}], "legacy": []}, "provenance": [{"description": "Unknown Ethiopian Vendor/Shop", "citations": [], "footnotes": null, "date": "–c. 2000", "sortorder": 2}, {"description": "Dr. Raymond Silverman", "citations": [], "footnotes": null, "date": "c. 2000–2025", "sortorder": 3}, {"description": "The Cleveland Museum of Art", "citations": [], "footnotes": null, "date": "2025", "sortorder": 4}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "Ethiopian silver jewelry is made by melting high-purity Maria Theresa thaler coins made from the 1700s to the 1900s.", "early_education_description": null, "artlens_description": null, "description": "Ornate filigree jewelry was historically made in Ethiopia for royals and nobility by specialized silversmiths trained through long apprenticeships. This silver necklace is composed of numerous box-shaped amulet pendants (<em>tälsäm)</em> meant to ward off the evil eye or other dangers. Linked to Islamic amuletic practices, the boxes are effective whether empty or whether they contain magical or prayerful texts. Their fine filigree and granulation work is characteristic of Harar as well as the Ethiopian Orthodox Christian city of Aksum.", "external_resources": {"wikidata": [], "internet_archive": []}, "citations": [], "url": "https://clevelandart.org/art/2025.152", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/2025.152/2025.152_web.jpg", "width": "656", "height": "900", "filesize": "87929", "filename": "2025.152_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/2025.152/2025.152_print.jpg", "width": "2478", "height": "3400", "filesize": "799477", "filename": "2025.152_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/2025.152/2025.152_full.tif", "width": "9355", "height": "12834", "filesize": "360213120", "filename": "2025.152_full.tif"}}, "alternate_images": [{"web": {"url": "https://openaccess-cdn.clevelandart.org/2025.152/2025.152_alt0_web.jpg", "width": "813", "height": "900", "filesize": "121644"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/2025.152/2025.152_alt0_print.jpg", "width": "3073", "height": "3400", "filesize": "1339212"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/2025.152/2025.152_alt0_full.tif", "width": "9403", "height": "10405", "filesize": "293542564"}, "date_created": "2025-09-25T15:24:56", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/2025.152/2025.152_alt1_web.jpg", "width": "900", "height": "893", "filesize": "120655"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/2025.152/2025.152_alt1_print.jpg", "width": "3400", "height": "3372", "filesize": "1306305"}, "full": {"url": "https://openaccess-cdn.cl