{"data": {"id": 101711, "accession_number": "1920.424", "share_license_status": "CC0", "tombstone": "Cup with Dragon Handles (雙龍耳杯)), 1662–1722. China, Qing dynasty (1644-1911), Kangxi reign (1662-1722). Pale gray-green white jade; diameter: 14.6 cm (5 3/4 in.); overall: 4.6 cm (1 13/16 in.). The Cleveland Museum of Art, Gift of J. H. Wade, 1920.424", "current_location": null, "title": "Cup with Dragon Handles", "title_in_original_language": "雙龍耳杯)", "creation_date": "1662–1722", "creation_date_earliest": 1662, "creation_date_latest": 1722, "artists_tags": [], "culture": ["China, Qing dynasty (1644-1911), Kangxi reign (1662-1722)"], "technique": "Pale gray-green white jade", "support_materials": [], "department": "Chinese Art", "collection": "China - Qing Dynasty", "type": "Jade", "measurements": "Diameter: 14.6 cm (5 3/4 in.); Overall: 4.6 cm (1 13/16 in.)", "dimensions": {"diameter": {"width": 0.146, "width_inch": 5, "width_inch_fraction": 0.75}, "overall": {"height": 0.046, "height_inch": 1, "height_inch_fraction": 0.8125}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [{"inscription": "萬壽長春", "inscription_translation": null, "inscription_remark": "Auspicious inscription on the base", "sortorder": 1}, {"inscription": "壽", "inscription_translation": "Longevity", "inscription_remark": "In a roundel on the front of the cup", "sortorder": 2}, {"inscription": "子剛造", "inscription_translation": "Inscribed characters: made by [Lu] Zigang", "inscription_remark": null, "sortorder": 3}], "exhibitions": {"current": [{"id": 443780, "title": "Chinese Jades: The Great Tradition", "description": "<i>Chinese Jades: The Great Tradition</i>. Cranbrook Institute of Science, Bloomfield Hills, MI (organizer) (September 10-October 31, 1977).", "opening_date": "1977-09-10T04:00:00"}, {"id": 448467, "title": "China through the Magnifying Glass: Masterpieces in Miniature and Detail", "description": "<i>China through the Magnifying Glass: Masterpieces in Miniature and Detail</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (December 11, 2022-February 26, 2023).", "opening_date": "2022-12-10T05:00:00"}, {"id": 395234, "title": "China’s Southern Paradise: Treasures from the Lower Yangzi Delta", "description": "<i>China’s Southern Paradise: Treasures from the Lower Yangzi Delta</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (September 10, 2023-January 7, 2024).", "opening_date": "2023-09-10T04:00:00"}], "legacy": [{"description": "<em>Chinese Jades from Han to Ch'ing</em>, Asia House Gallery, New York, NY (October 9-December 7, 1980); Detroit Institute of Fine Arts, Detroit, MI (January 12-February 22, 1981); Seattle Art Museum, Seattle, WA (March 26-May 10, 1981); Honolulu Academy of Arts, Honolulu, HI (May 17-September 13, 1981).", "opening_date": "1980-10-09T04:00:00Z"}]}, "provenance": [{"description": "Mr. Jeptha Homer Wade II [1857–1926], Cleveland, OH, given to the Cleveland Museum of Art", "citations": [], "footnotes": null, "date": "?–1920", "sortorder": 1}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": null, "date": "1920–", "sortorder": 2}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "Auspicious inscriptions on the base and front of the jade cup convey wishes for longevity.", "early_education_description": null, "artlens_description": null, "description": "Three dragons, auspicious symbols for good fortune, grasp the rim of this bowl. A large <em>shou </em>(longevity) character is visible on the outside wall. Drinking cups with dragon handles were elite luxuries. The yellowish-white color and refined techniques are characteristic of Suzhou workshops that served the court, scholar-officials, and the merchant class. The optimistic attribution to Lu Zigang (late 1500s), a jade master recorded to have been active in Suzhou, suggests that its maker used the master’s name to attract wealthy clients eager to demonstrate their refined taste and connoisseurship.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q79497378"], "internet_archive": ["https://archive.org/details/clevelandart-1920.424-libation-cup", "https://archive.org/details/clevelandart-1920.424-cup-with-dragon-hand"]}, "citations": [{"citation": "Michigan Oriental Art Society, and Cranbrook Institute of Science. <em>Chinese Jades, the Great Tradition: Exhibition Sponsored Jointly by Michigan Oriental Art Society and Cranbrook Institute of Science at Cranbrook Institute of Science</em>. Bloomfield Hills, MI: The Society, 1977.", "page_number": "Reproduced: cat. no. 25, cover photo", "url": ""}, {"citation": "Watt, James C. Y. <em>Chinese Jades from Han to Chʻing</em>. New York: Asia Society, in association with J. Weatherhill, 1980.", "page_number": "cat. no. 139", "url": ""}, {"citation": "Griswold, William, Xiaofei Tian, Richard Von Glahn, Feng Zhao, S. J. Vainker, Masaaki Itakura, Jiang Wu, et al. <em>China’s Southern Paradise: Treasures from the Lower Yangzi Delta</em>. Edited by Clarissa von Spee. Cleveland, OH: The Cleveland Museum of Art, 2023.", "page_number": "Mentioned and Reproduced: p. 358, no. 194", "url": ""}], "url": "https://clevelandart.org/art/1920.424", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/1920.424/1920.424_web.jpg", "width": "900", "height": "585", "filesize": "87206", "filename": "1920.424_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1920.424/1920.424_print.jpg", "width": "3400", "height": "2210", "filesize": "728835", "filename": "1920.424_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1920.424/1920.424_full.tif", "width": "7320", "height": "4759", "filesize": "104535508", "filename": "1920.424_full.tif"}}, "alternate_images": [{"web": {"url": "https://openaccess-cdn.clevelandart.org/1920.424/1920.424_alt0_web.jpg", "width": "900", "height": "526", "files