{"data": {"id": 156536, "accession_number": "1992.246", "share_license_status": "CC0", "tombstone": "Ibex Standard Finial, c. 700–600 BCE. Iran, Luristan. Bronze; overall: 13.5 x 9.7 x 1.9 cm (5 5/16 x 3 13/16 x 3/4 in.). The Cleveland Museum of Art, Seventy-fifth anniversary gift of Clara Taplin Rankin, 1992.246", "current_location": "102A Ancient Near East", "title": "Ibex Standard Finial", "creation_date": "c. 700–600 BCE", "creation_date_earliest": -700, "creation_date_latest": -600, "artists_tags": [], "culture": ["Iran, Luristan"], "technique": "bronze", "support_materials": [], "department": "Egyptian and Ancient Near Eastern Art", "collection": "Near Eastern Art", "type": "Sculpture", "measurements": "Overall: 13.5 x 9.7 x 1.9 cm (5 5/16 x 3 13/16 x 3/4 in.)", "dimensions": {"overall": {"height": 0.135, "height_inch": 5, "height_inch_fraction": 0.3125, "width": 0.097, "width_inch": 3, "width_inch_fraction": 0.8125, "depth": 0.019, "depth_inch": 0, "depth_inch_fraction": 0.75}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [], "exhibitions": {"current": [{"id": 311552, "title": "Selected Acquisitions", "description": "<i>Selected Acquisitions</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (February 9-April 11, 1993).", "opening_date": "1993-02-09T05:00:00"}], "legacy": []}, "provenance": [], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "Ibexes are wild goats from the Zagros Mountains of Iran and the Caucasus.", "early_education_description": null, "artlens_description": null, "description": "This standard finial, a decorative tube perhaps used as a military emblem, is made of two abstracted ibexes. Their elongated forelegs form a ring where a pole may have once been inserted. An additional horizontal bar extends from their chests to support the ring. The cast bronze ibexes are decorated with ridged horns, curled beards, and twisted tails. Their hind legs join another ring. This standard is likely from Luristan, home to a seminomadic people who created a strong metalworking industry in the Iron Age.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q60746121"], "internet_archive": ["https://archive.org/details/clevelandart-1992.246-ibex-standard-finial"]}, "citations": [{"citation": "Turner, Evan H. \"The Year in Review for 1992.\" <em>The Bulletin of the Cleveland Museum of Art</em> 80, no. 2 (1993): 38-79.", "page_number": "Reproduced: p. 52; Mentioned: p. 65", "url": "https://www.jstor.org/stable/25161388"}], "url": "https://clevelandart.org/art/1992.246", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/1992.246/1992.246_web.jpg", "width": "761", "height": "893", "filesize": "325173", "filename": "1992.246_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1992.246/1992.246_print.jpg", "width": "2896", "height": "3400", "filesize": "5284150", "filename": "1992.246_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1992.246/1992.246_full.tif", "width": "3662", "height": "4299", "filesize": "47265348", "filename": "1992.246_full.tif"}}, "alternate_images": [{"web": {"url": "https://openaccess-cdn.clevelandart.org/1992.246/1992.246_alt0_web.jpg", "width": "752", "height": "893", "filesize": "311081"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1992.246/1992.246_alt0_print.jpg", "width": "2865", "height": "3400", "filesize": "5162366"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1992.246/1992.246_alt0_full.tif", "width": "3697", "height": "4387", "filesize": "48695108"}, "date_created": "2008-04-16T19:43:20", "annotation": ""}], "creditline": "Seventy-fifth anniversary gift of Clara Taplin Rankin", "image_credit": null, "sketchfab_id": null, "sketchfab_url": null, "models": null, "gallery_donor_text": null, "athena_id": 156536, "creators": [], "legal_status": "accessioned", "accession_date": "1992-12