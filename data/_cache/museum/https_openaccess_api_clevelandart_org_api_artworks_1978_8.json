{"data": {"id": 149430, "accession_number": "1978.8", "share_license_status": "CC0", "tombstone": "Kneeling Male Figure, 1010–80. Cambodia, Angkor, Baphuon, Baphuon period, 1000s. Bronze; overall: 43.2 cm (17 in.). The Cleveland Museum of Art, Leonard C. Hanna Jr. Fund, 1978.8", "current_location": null, "title": "Kneeling Male Figure", "creation_date": "1010–80", "creation_date_earliest": 1010, "creation_date_latest": 1080, "artists_tags": [], "culture": ["Cambodia, Angkor, Baphuon, Baphuon period, 1000s"], "technique": "bronze", "support_materials": [], "department": "Indian and Southeast Asian Art", "collection": "Cambodian Art", "type": "Sculpture", "measurements": "Overall: 43.2 cm (17 in.)", "dimensions": {"overall": {"height": 0.432, "height_inch": 17, "height_inch_fraction": 0.0}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [], "exhibitions": {"current": [{"id": 304286, "title": "Year in Review: 1978", "description": "<i>Year in Review: 1978</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (February 13-March 18, 1979).", "opening_date": "1979-02-13T05:00:00"}, {"id": 310102, "title": "Art Nouveau in France", "description": "<i>Art Nouveau in France</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (July 12-November 27, 1988).", "opening_date": "1988-07-12T04:00:00"}, {"id": 187217, "title": "Object in Focus: Kneeling Male Figure", "description": "<i>Object in Focus: Kneeling Male Figure</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (August 15-October 15, 2000).", "opening_date": "2000-08-15T00:00:00"}, {"id": 196054, "title": "Streams and Mountains Without End: Asian Art and the Legacy of Sherman E. Lee at the Cleveland Museum of Art", "description": "<i>Streams and Mountains Without End: Asian Art and the Legacy of Sherman E. Lee at the Cleveland Museum of Art</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (June 27-August 23, 2009).", "opening_date": "2009-06-27T04:00:00"}], "legacy": []}, "provenance": [{"description": "(Spink & Son, Ltd., London, England, sold to the Cleveland Museum of Art)", "citations": [], "footnotes": null, "date": "by 1975–1978", "sortorder": 1}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": [], "date": "1978–", "sortorder": 2}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "This bronze figure was cast using the lost-wax (<em>cire perdu</em>) technique with the core armature inside.", "early_education_description": null, "artlens_description": null, "description": "The third eye in the forehead indicates that this figure identified himself with Shiva, but his kneeling stance with hands raised in a gesture of adoration indicates that he is a devotee of Shiva, who has taken on aspects of the god's physical appearance. The style of the lower garment with the low-slung belt is typical of work from the so-called Baphuon period of Khmer sculpture, like the stone standing image to the left. The eyes, eyebrows, moustache, and beard were once inlaid with silver.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q60757640"], "internet_archive": ["https://archive.org/details/clevelandart-1978.8-kneeling-male-figure"]}, "citations": [{"citation": "Spink &amp; Son. <em>Octagon,</em> XXII no. 3 (Autumn 1975): pp. 24-25.", "page_number": "Reproduced: pp. 24–25", "url": null}, {"citation": "Lee, Sherman E. “The Year in Review for 1978.” <em>The Bulletin of the Cleveland Museum of Art</em>, vol. 66, no. 1, 1979, pp. 3–47.", "page_number": "Reproduced: cat. no. 156, p. 28", "url": "https://www.jstor.org/stable/25159613"}, {"citation": "\"Report from America.\" <em>Oriental Art</em>, vol, XXV.1 (Spring 1979), p. 120.", "page_number": "Reproduced: p. 120, fig. 6", "url": null}, {"citation": "Bunker, Emma C., and Douglas Latchford. <em>Adoration and Glory: The Golden Age of Khmer Ar</em>t. Chicago: Art Media Resou