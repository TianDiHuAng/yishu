40"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1944.485/1944.485_alt14_full.tif", "width": "4238", "height": "2796", "filesize": "35576424"}, "date_created": "2010-03-25T18:50:01", "annotation": ""}], "creditline": "Purchase from the J. H. Wade Fund", "image_credit": null, "sketchfab_id": "4d4dfba6506d40b09b7eb34c642afab7", "sketchfab_url": "https://sketchfab.com/models/4d4dfba6506d40b09b7eb34c642afab7", "models": {"mobile": {"url": "https://3d.clevelandart.org/1944.485/mobile/1944.485.glb", "sha256": "f0990764297b85d3e9fb1f02f67394c14293ee2f2a0db92bfc4f8fce10c836fa", "updated_at": "2026-11-18T21:40:58"}}, "gallery_donor_text": null, "athena_id": 123985, "creators": [], "legal_status": "accessioned", "accession_date": "1944-12-15T00:00:00", "sortable_date": 1200, "date_added_to_oa": null, "date_text": "1200–1221", "collapse_artists": false, "on_loan": false, "recently_acquired": false, "record_type": "object", "conservation_statement": null, "has_conservation_images": false, "cover_accession_number": null, "is_nazi_era_provenance": false, "impression": null, "alternate_titles": ["Silver Inlaid Brass Bowl", "The Wade Cup", "Footed Bowl"], "is_highlight": true, "updated_at": "2026-11-20 20:18:06.792000"}}